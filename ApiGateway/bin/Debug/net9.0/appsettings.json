{
  "ReverseProxy": {
    "Routes": {
      "users-route": {
        "ClusterId": "users-cluster",
        "Match": { "Path": "/api/users/{**catch-all}" },
        "Transforms": [ { "PathRemovePrefix": "/api/users" } ]
      },
      "exercisesRoute": {
        "ClusterId": "exercisesCluster",
        "Match": { "Path": "/api/exercises/{**catch-all}" },
        "Transforms": [ { "PathRemovePrefix": "/api/exercises" } ]
      },
      //"progressRoute": {
      //  "ClusterId": "progress-cluster",
      //  "Match": { "Path": "/api/progress/{**catch-all}" },
      //  "Transforms": [ { "PathRemovePrefix": "/api/progress" } ]
      //},
      "speechRoute": {
        "ClusterId": "speech-cluster",
        "Match": { "Path": "/api/speech/{**catch-all}" },
        "Transforms": [ { "PathRemovePrefix": "/api/speech" } ]
      },

      "userServiceHealth": {
        "ClusterId": "users-cluster",
        "Match": { "Path": "/users/health/{**catch-all}" },
        "Transforms": [ { "PathRemovePrefix": "/users" } ]
      },
      "exerciseServiceHealth": {
        "ClusterId": "exercisesCluster",
        "Match": { "Path": "/exercises/health" },
        "Transforms": [ { "PathRemovePrefix": "/exercises" } ]
      },
      //"progressServiceHealth": {
      //  "ClusterId": "progress-cluster",
      //  "Match": { "Path": "/progress/health" },
      //  "Transforms": [ { "PathRemovePrefix": "/progress" } ]
      //},
      "speechServiceHealth": {
        "ClusterId": "speech-cluster",
        "Match": { "Path": "/speech/health" },
        "Transforms": [ { "PathRemovePrefix": "/speech" } ]
      }
    },

    "Clusters": {
      "users-cluster": {
        "Destinations": {
          "users-service": { "Address": "http://localhost:5001" }
        }
      },
      "exercisesCluster": {
        "Destinations": {
          "exDest": { "Address": "http://localhost:5002" }
        }
      },
      //"progress-cluster": {
      //  "Destinations": {
      //    "progressDest": { "Address": "http://localhost:5003" }
      //  }
      //},
      "speech-cluster": {
        "Destinations": {
          "speechDest": { "Address": "http://localhost:5004" }
        }
      }
    }
  }
}