{
  "ReverseProxy": {
    "Routes": {
      "users-route": {
        "ClusterId": "users-cluster",
        "Match": { "Path": "/api/users/{**catch-all}" },
        "Transforms": [ { "PathRemovePrefix": "/api/users" } ]
      },
      "exercisesRoute": {
        "ClusterId": "exercisesCluster",
        "Match": { "Path": "/api/exercises/{**catch-all}" }
      },
      "progressRoute": {
        "ClusterId": "progressCluster",
        "Match": { "Path": "/api/progress/{**catch-all}" }
      },



      "userServiceHealth": {
        "ClusterId": "usersCluster",
        "Match": { "Path": "/health/users" },
        "Transforms": [
          { "PathPattern": "/health" }
        ]
      },
      "exerciseServiceHealth": {
        "ClusterId": "exercisesCluster",
        "Match": { "Path": "/health/exercises" },
        "Transforms": [
          { "PathPattern": "/health" }
        ]
      },
      "progressServiceHealth": {
        "ClusterId": "progressCluster",
        "Match": { "Path": "/health/progress" },
        "Transforms": [
          { "PathPattern": "/health" }
        ]
      }
    },






    "Clusters": {
      "users-cluster": {
        "Destinations": {
          "users-service": { "Address": "http://localhost:5001" }
        }
      },
      "exercisesCluster": {
        "Destinations": {
          "exDest": { "Address": "http://localhost:5002" }
        }
      },
      "progressCluster": {
        "Destinations": {
          "progressDest": { "Address": "http://localhost:5003" }
        }
      }
    }
  }
}
