{
  "openapi": "3.0.1",
  "info": {
    "title": "ExerciseService",
    "version": "1.0"
  },
  "paths": {
    "/api/Exercises/start": {
      "post": {
        "tags": [
          "Exercises"
        ],
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/ExerciseRequest"
              }
            },
            "text/json": {
              "schema": {
                "$ref": "#/components/schemas/ExerciseRequest"
              }
            },
            "application/*+json": {
              "schema": {
                "$ref": "#/components/schemas/ExerciseRequest"
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "OK"
          }
        }
      }
    },
    "/api/Exercises/upload-audio": {
      "post": {
        "tags": [
          "Exercises"
        ],
        "requestBody": {
          "content": {
            "multipart/form-data": {
              "schema": {
                "type": "object",
                "properties": {
                  "File": {
                    "type": "string",
                    "format": "binary"
                  },
                  "ExerciseId": {
                    "type": "integer",
                    "format": "int32"
                  },
                  "UserId": {
                    "type": "integer",
                    "format": "int32"
                  },
                  "ReferenceText": {
                    "type": "string"
                  }
                }
              },
              "encoding": {
                "File": {
                  "style": "form"
                },
                "ExerciseId": {
                  "style": "form"
                },
                "UserId": {
                  "style": "form"
                },
                "ReferenceText": {
                  "style": "form"
                }
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "OK"
          }
        }
      }
    },
    "/health": {
      "get": {
        "tags": [
          "ExerciseService"
        ],
        "responses": {
          "200": {
            "description": "OK"
          }
        }
      }
    }
  },
  "components": {
    "schemas": {
      "ExerciseRequest": {
        "type": "object",
        "properties": {
          "exerciseId": {
            "type": "integer",
            "format": "int32"
          },
          "userId": {
            "type": "integer",
            "format": "int32"
          },
          "audioUrl": {
            "type": "string",
            "nullable": true
          },
          "referenceText": {
            "type": "string",
            "nullable": true
          }
        },
        "additionalProperties": false
      }
    }
  }
}