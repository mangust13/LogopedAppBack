{
  "openapi": "3.0.1",
  "info": {
    "title": "SpeechAIService",
    "version": "1.0"
  },
  "paths": {
    "/api/Ai/analyze": {
      "post": {
        "tags": [
          "Ai"
        ],
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/SpeechRequest"
              }
            },
            "text/json": {
              "schema": {
                "$ref": "#/components/schemas/SpeechRequest"
              }
            },
            "application/*+json": {
              "schema": {
                "$ref": "#/components/schemas/SpeechRequest"
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "OK",
            "content": {
              "text/plain": {
                "schema": {
                  "$ref": "#/components/schemas/SpeechResultDto"
                }
              },
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/SpeechResultDto"
                }
              },
              "text/json": {
                "schema": {
                  "$ref": "#/components/schemas/SpeechResultDto"
                }
              }
            }
          }
        }
      }
    }
  },
  "components": {
    "schemas": {
      "SpeechRequest": {
        "type": "object",
        "properties": {
          "exerciseId": {
            "type": "string",
            "nullable": true
          },
          "userId": {
            "type": "string",
            "nullable": true
          },
          "audioUrl": {
            "type": "string",
            "nullable": true
          },
          "referenceText": {
            "type": "string",
            "nullable": true
          }
        },
        "additionalProperties": false
      },
      "SpeechResultDto": {
        "type": "object",
        "properties": {
          "exerciseId": {
            "type": "string",
            "nullable": true
          },
          "userId": {
            "type": "string",
            "nullable": true
          },
          "accuracyScore": {
            "type": "number",
            "format": "double"
          },
          "recognizedIPA": {
            "type": "string",
            "nullable": true
          },
          "feedback": {
            "type": "string",
            "nullable": true
          }
        },
        "additionalProperties": false
      }
    }
  }
}