            "text/json": {
              "schema": {
                "$ref": "#/components/schemas/AssignLogopedDto"
              }
            },
            "application/*+json": {
              "schema": {
                "$ref": "#/components/schemas/AssignLogopedDto"
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "OK"
          }
        }
